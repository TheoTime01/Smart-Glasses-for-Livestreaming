{
  "name": "mrbd-live-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "api.video live viewer for Meta Ray-Ban Display",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "test": "vitest run",
    "gen:assets": "node scripts/gen-assets.mjs",
    "fetch:samples": "node scripts/fetch-samples.mjs",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.12",
    "eslint": "^9.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.10",
    "ws": "^8.18.0"
  }
}
