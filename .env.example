# ---------------------------------------------------------------- milestone 0
PORT=3000
HOST=0.0.0.0

# Public HTTPS origin the glasses load (tunnel or deployed URL).
# HTTPS is mandatory: the glasses runtime and service workers both require it,
# so an http:// value here fails at startup (localhost is exempt for dev).
PUBLIC_BASE_URL=

# Where probe reports are appended as JSONL.
PROBE_LOG_DIR=data/probe
PROBE_MEMORY_LIMIT=50

# Media the probe tests against. Defaults (used when unset):
#   HLS: Apple's public bipbop reference stream (sends Access-Control-Allow-Origin: *)
#   MP4: test-videos.co.uk 1 MB Big Buck Bunny clip
# `npm run fetch:samples` downloads the MP4 to public/samples/sample.mp4, after
# which the probe prefers the same-origin copy and PROBE_SAMPLE_MP4_URL is unused.
PROBE_SAMPLE_HLS_URL=
PROBE_SAMPLE_MP4_URL=

# ---------------------------------------------------------------- milestone 1
# api.video API key. Server-side only — it is never sent to a browser.
# Leave empty to run the probe alone: /api/streams and /control then answer 503.
# If it is set but wrong, the server refuses to start.
API_VIDEO_KEY=

# sandbox | production. Sandbox assets are watermarked and deleted after 24h.
API_VIDEO_ENV=sandbox

# Shared secret for /api/streams and /control. Strongly recommended whenever the
# server is reachable publicly (a tunnel counts) — those routes hand out RTMP
# credentials and can create api.video resources. Unset means no auth.
# Sent as an x-control-token header; only the QR image route also accepts it as
# ?control_token=, because an <img> cannot set headers.
CONTROL_TOKEN=

# How long a stream's broadcasting flag is reused before re-asking api.video.
STATUS_CACHE_TTL_MS=5000

# Testing only: point the api.video client at a local stub instead of the real
# service. Leave unset in every real deployment.
API_VIDEO_BASE_URL=

# ---------------------------------------------------------------- milestone 2
# Signs device tokens. Any long random string; changing it unpairs every device.
# Leave empty to disable pairing and the glasses app (the probe still works).
# Device tokens expire after 90 days; revoking on /control/ kills one instantly.
JWT_SECRET=

# How long a pairing code stays claimable, and how many claim attempts one
# client may make per minute (a 6-digit code is only 10^6 wide).
PAIRING_CODE_TTL=300
PAIR_CLAIM_LIMIT=10

# Root for anything the server persists (paired devices, probe reports).
DATA_DIR=data

# ------------------------------------------------- milestone 4+ (not yet used)
# RELAY_FPS=6
# RELAY_JPEG_QUALITY=75
